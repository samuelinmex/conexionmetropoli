---
import '../styles/global.css';
const {
  title = 'Conexión Metrópoli — Identidad digital con presencia',
  description = 'Diseño y desarrollo de sitios web modernos, rápidos y profesionales para negocios que quieren crecer con una identidad digital sólida.'
} = Astro.props;
const nav = [
  ['Inicio','/'],
  ['Servicios','/servicios'],
  ['Proyectos','/proyectos'],
  ['Nosotros','/nosotros'],
  ['Contacto','/contacto']
];
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07172f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <div class="noise" aria-hidden="true"></div>
    <header class="site-header" id="top">
      <a class="brand" href="/" aria-label="Conexión Metrópoli, inicio">
        <svg class="brand-mark" viewBox="0 0 160 72" aria-hidden="true">
          <rect x="2" y="2" width="72" height="68" rx="18" fill="currentColor"/>
          <circle cx="36" cy="36" r="23" fill="#fff"/>
          <path d="M14 36h44M36 13c8 7 12 15 12 23S44 52 36 59M36 13c-8 7-12 15-12 23s4 16 12 23M18 23h36M18 49h36" fill="none" stroke="#166fff" stroke-width="4" stroke-linecap="round"/>
          <path d="M82 70V2h76v68h-17V28l-21 18-21-18v42H82Z" fill="currentColor"/>
          <path d="M107 70V54h9V42h9v28h9V58h9v12" fill="#fff"/>
        </svg>
        <span class="brand-type"><b>CONEXIÓN</b><small>METRÓPOLI</small></span>
      </a>
      <nav class="desktop-nav" aria-label="Principal">
        {nav.map(([label,href]) => <a href={href}>{label}</a>)}
      </nav>
      <a class="button button-small header-cta" href="/contacto">Cotizar proyecto</a>
      <button class="menu-toggle" aria-label="Abrir menú" aria-expanded="false"><span></span><span></span></button>
      <div class="mobile-nav" hidden>
        {nav.map(([label,href]) => <a href={href}>{label}</a>)}
        <a class="button" href="/contacto">Cotizar proyecto</a>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div>
        <a class="brand footer-brand" href="/">
          <span class="brand-type"><b>CONEXIÓN</b><small>METRÓPOLI</small></span>
        </a>
        <p>Construimos presencia digital que se siente profesional desde el primer vistazo.</p>
      </div>
      <div class="footer-links">
        <a href="/servicios">Servicios</a><a href="/proyectos">Proyectos</a><a href="/nosotros">Nosotros</a><a href="/contacto">Contacto</a>
      </div>
      <div class="footer-meta"><span>© 2026 Conexión Metrópoli</span><span>Desde México para negocios que quieren crecer.</span></div>
    </footer>
    <script>
      const toggle = document.querySelector('.menu-toggle');
      const mobile = document.querySelector('.mobile-nav');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        if (mobile) mobile.hidden = open;
      });
      const reveal = new IntersectionObserver((entries) => {
        entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add('is-visible'));
      }, { threshold: .14 });
      document.querySelectorAll('[data-reveal]').forEach(el => reveal.observe(el));
    </script>
  </body>
</html>
