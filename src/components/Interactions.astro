<div class="cm-pointer-ring" aria-hidden="true"></div>

<style is:global>
  body {
    animation: cm-page-fade-in .18s ease-out both;
  }

  body.cm-page-leaving {
    animation: none !important;
    opacity: 0;
    transition: opacity .12s ease-in !important;
  }

  @keyframes cm-page-fade-in {
    from { opacity: .18; }
    to { opacity: 1; }
  }

  @media (pointer:fine) {
    a[href], button, [role="button"], .project-card {
      cursor: pointer !important;
    }

    .cm-pointer-ring {
      position: fixed;
      left: 0;
      top: 0;
      width: 25px;
      height: 25px;
      border: 1.5px solid rgba(22,111,255,.68);
      border-radius: 999px;
      background: rgba(22,111,255,.025);
      box-shadow: 0 0 0 1px rgba(255,255,255,.36), 0 3px 16px rgba(22,111,255,.08);
      pointer-events: none;
      z-index: 10000;
      opacity: 0;
      transform: translate(-50%,-50%);
      transition: width .15s cubic-bezier(.22,1,.36,1), height .15s cubic-bezier(.22,1,.36,1), opacity .12s ease, background .15s ease, border-color .15s ease, box-shadow .15s ease;
      will-change: left, top, width, height;
    }

    .cm-pointer-ring.is-interactive {
      width: 34px;
      height: 34px;
      opacity: .92;
      border-color: rgba(22,111,255,.82);
      background: rgba(22,111,255,.055);
      box-shadow: 0 0 0 4px rgba(22,111,255,.035), 0 4px 18px rgba(22,111,255,.10);
    }

    .cm-pointer-ring.is-down {
      width: 23px;
      height: 23px;
      background: rgba(22,111,255,.14);
      border-color: rgba(22,111,255,.95);
    }

    .cm-click-ripple {
      position: fixed;
      width: 12px;
      height: 12px;
      border: 1.5px solid rgba(22,111,255,.76);
      border-radius: 50%;
      pointer-events: none;
      z-index: 9999;
      transform: translate(-50%,-50%) scale(.55);
      opacity: .82;
      animation: cm-pointer-ripple .36s cubic-bezier(.16,1,.3,1) forwards;
    }

    @keyframes cm-pointer-ripple {
      to {
        width: 54px;
        height: 54px;
        opacity: 0;
        transform: translate(-50%,-50%) scale(1);
      }
    }
  }

  @media (pointer:coarse) {
    .cm-pointer-ring { display:none !important; }
  }

  @media (prefers-reduced-motion:reduce) {
    body { animation:none !important; }
    body.cm-page-leaving { opacity:1 !important; transition:none !important; }
    .cm-pointer-ring,.cm-click-ripple { display:none !important; }
  }

  /* Project carousel: make the real work the visual hero, not the overlay copy. */
  .stories-showcase .impact-carousel {
    background: #071327 !important;
    box-shadow: 0 34px 90px rgba(6, 23, 48, .16) !important;
  }

  .stories-showcase .impact-stage {
    height: clamp(700px, 56vw, 980px) !important;
    background: #071327 !important;
  }

  .stories-showcase .impact-slide {
    background: #071327 !important;
  }

  .stories-showcase .impact-image {
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: top center !important;
    transform: scale(1.012) !important;
    filter: none !important;
    transition: transform 6.5s cubic-bezier(.2,.65,.2,1), opacity .55s ease !important;
  }

  .stories-showcase .impact-slide.is-active .impact-image {
    transform: scale(1) !important;
    filter: none !important;
  }

  .stories-showcase .impact-shade {
    background:
      linear-gradient(0deg, rgba(3,13,30,.48) 0%, rgba(3,13,30,.17) 25%, rgba(3,13,30,0) 48%),
      linear-gradient(90deg, rgba(3,13,30,.12) 0%, rgba(3,13,30,0) 34%) !important;
  }

  .stories-showcase .impact-topline {
    top: 22px !important;
    left: clamp(20px,3vw,52px) !important;
    right: clamp(20px,3vw,52px) !important;
    height: auto !important;
    padding: 0 !important;
    border: 0 !important;
    background: transparent !important;
    backdrop-filter: none !important;
    color: #07172f !important;
    align-items: flex-start !important;
  }

  .stories-showcase .impact-domain,
  .stories-showcase .impact-project {
    padding: 10px 14px !important;
    border-radius: 999px !important;
    background: rgba(255,255,255,.88) !important;
    border: 1px solid rgba(255,255,255,.7) !important;
    box-shadow: 0 10px 30px rgba(7,23,47,.12) !important;
    backdrop-filter: blur(16px) !important;
    color: #07172f !important;
  }

  .stories-showcase .impact-domain i {
    background: #a9b9cd !important;
  }

  .stories-showcase .impact-project {
    color: #07172f !important;
    font-size: .66rem !important;
  }

  .stories-showcase .impact-content-wrap {
    height: 100% !important;
    padding-top: 100px !important;
    padding-bottom: 34px !important;
    align-items: flex-end !important;
  }

  .stories-showcase .impact-copy {
    width: min(530px, calc(100vw - 48px)) !important;
    padding: 24px 26px 23px !important;
    border-radius: 24px !important;
    background: rgba(5,18,38,.84) !important;
    border: 1px solid rgba(255,255,255,.18) !important;
    box-shadow: 0 24px 70px rgba(0,0,0,.28) !important;
    backdrop-filter: blur(20px) saturate(120%) !important;
    color: #fff !important;
    transform: translateY(14px) !important;
  }

  .stories-showcase .impact-slide.is-active .impact-copy {
    transform: translateY(0) !important;
  }

  .stories-showcase .impact-kicker {
    margin-bottom: 9px !important;
    font-size: .66rem !important;
    color: #79aaff !important;
  }

  .stories-showcase .impact-copy h3 {
    margin: 0 0 12px !important;
    font-size: clamp(2.2rem, 3.5vw, 3.55rem) !important;
    line-height: .94 !important;
    letter-spacing: -.045em !important;
    text-shadow: none !important;
  }

  .stories-showcase .impact-copy > p {
    margin: 0 0 14px !important;
    max-width: 470px !important;
    font-size: .96rem !important;
    line-height: 1.5 !important;
    color: rgba(255,255,255,.82) !important;
  }

  .stories-showcase .impact-detail {
    display: block !important;
    margin: 0 0 16px !important;
    padding: 12px 14px !important;
    border-radius: 14px !important;
    background: rgba(255,255,255,.07) !important;
    border-color: rgba(255,255,255,.11) !important;
  }

  .stories-showcase .impact-detail strong {
    display: block !important;
    margin-bottom: 4px !important;
    color: #79aaff !important;
  }

  .stories-showcase .impact-detail span {
    font-size: .82rem !important;
    line-height: 1.42 !important;
    color: rgba(255,255,255,.9) !important;
  }

  .stories-showcase .impact-cta {
    padding: 11px 16px !important;
    font-size: .82rem !important;
  }

  .stories-showcase .impact-index {
    right: clamp(22px,3vw,52px) !important;
    bottom: 28px !important;
    padding: 9px 12px !important;
    border-radius: 999px !important;
    background: rgba(5,18,38,.72) !important;
    border: 1px solid rgba(255,255,255,.16) !important;
    backdrop-filter: blur(14px) !important;
    font-size: 1rem !important;
  }

  .stories-showcase .impact-controls {
    height: 68px !important;
    background: #071327 !important;
  }

  @media (max-width: 900px) {
    .stories-showcase .impact-stage {
      height: 760px !important;
    }
    .stories-showcase .impact-image {
      object-position: top center !important;
    }
    .stories-showcase .impact-copy {
      width: min(500px, calc(100vw - 40px)) !important;
      padding: 21px 22px !important;
    }
    .stories-showcase .impact-copy h3 {
      font-size: clamp(2.2rem, 8vw, 3.4rem) !important;
    }
  }

  @media (max-width: 620px) {
    .stories-showcase .impact-stage {
      height: 700px !important;
    }
    .stories-showcase .impact-topline {
      top: 14px !important;
      left: 14px !important;
      right: 14px !important;
    }
    .stories-showcase .impact-domain {
      padding: 8px 10px !important;
    }
    .stories-showcase .impact-content-wrap {
      padding: 70px 16px 18px !important;
    }
    .stories-showcase .impact-copy {
      width: 100% !important;
      padding: 18px !important;
      border-radius: 20px !important;
    }
    .stories-showcase .impact-copy h3 {
      font-size: 2.35rem !important;
    }
    .stories-showcase .impact-copy > p {
      font-size: .9rem !important;
    }
    .stories-showcase .impact-detail {
      display: none !important;
    }
    .stories-showcase .impact-index {
      top: 64px !important;
      bottom: auto !important;
      right: 14px !important;
    }
  }
</style>

<script>
  const PROJECT_IMAGES = {
    fastTrack: '/assets/fasttrack-story.png?v=8',
    miArmario: '/assets/miarmario-story.png?v=8'
  };

  const repairProjectImages = () => {
    document.querySelectorAll('img').forEach((img) => {
      if (!(img instanceof HTMLImageElement)) return;

      const alt = (img.alt || '').toLowerCase();
      const current = img.getAttribute('src') || '';
      const isFastTrack = alt.includes('fast track english coach') || current.includes('fasttrack-story');
      const isMiArmario = alt.includes('mi armario cancún') || alt.includes('mi armario cancun') || current.includes('miarmario-story');

      if (isFastTrack) {
        if (img.getAttribute('src') !== PROJECT_IMAGES.fastTrack) img.setAttribute('src', PROJECT_IMAGES.fastTrack);
        img.removeAttribute('srcset');
        img.decoding = 'async';
      } else if (isMiArmario) {
        if (img.getAttribute('src') !== PROJECT_IMAGES.miArmario) img.setAttribute('src', PROJECT_IMAGES.miArmario);
        img.removeAttribute('srcset');
        img.decoding = 'async';
      }
    });
  };

  repairProjectImages();
  document.addEventListener('DOMContentLoaded', repairProjectImages, { once:true });
  window.addEventListener('pageshow', repairProjectImages);

  const finePointer = window.matchMedia('(pointer:fine)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion:reduce)');
  const ring = document.querySelector('.cm-pointer-ring');

  if (finePointer.matches && ring instanceof HTMLElement) {
    let targetX = -100;
    let targetY = -100;
    let currentX = -100;
    let currentY = -100;
    let visible = false;

    const interactiveSelector = 'a[href],button,[role="button"],.project-card';

    const animateRing = () => {
      currentX += (targetX - currentX) * .34;
      currentY += (targetY - currentY) * .34;
      ring.style.left = `${currentX}px`;
      ring.style.top = `${currentY}px`;
      requestAnimationFrame(animateRing);
    };
    requestAnimationFrame(animateRing);

    document.addEventListener('pointermove', (event) => {
      targetX = event.clientX;
      targetY = event.clientY;
      if (!visible) {
        currentX = targetX;
        currentY = targetY;
        visible = true;
      }
      const target = event.target instanceof Element ? event.target.closest(interactiveSelector) : null;
      ring.classList.toggle('is-interactive', Boolean(target));
    }, { passive:true });

    document.addEventListener('pointerdown', (event) => {
      const target = event.target instanceof Element ? event.target.closest(interactiveSelector) : null;
      if (!target) return;

      ring.classList.add('is-down');
      const ripple = document.createElement('span');
      ripple.className = 'cm-click-ripple';
      ripple.style.left = `${event.clientX}px`;
      ripple.style.top = `${event.clientY}px`;
      document.body.appendChild(ripple);
      window.setTimeout(() => ripple.remove(), 420);
    }, { passive:true });

    const release = () => ring.classList.remove('is-down');
    document.addEventListener('pointerup', release, { passive:true });
    document.addEventListener('pointercancel', release, { passive:true });
    document.documentElement.addEventListener('mouseleave', () => ring.classList.remove('is-interactive'));
  }

  document.addEventListener('click', (event) => {
    if (event.defaultPrevented || reducedMotion.matches) return;
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

    const target = event.target instanceof Element ? event.target.closest('a[href]') : null;
    if (!(target instanceof HTMLAnchorElement)) return;
    if (target.target === '_blank' || target.hasAttribute('download')) return;

    const rawHref = target.getAttribute('href');
    if (!rawHref || rawHref.startsWith('#') || rawHref.startsWith('mailto:') || rawHref.startsWith('tel:')) return;

    const destination = new URL(target.href, window.location.href);
    if (destination.origin !== window.location.origin) return;
    if (destination.pathname === window.location.pathname && destination.search === window.location.search) return;

    event.preventDefault();
    document.body.classList.add('cm-page-leaving');
    window.setTimeout(() => {
      window.location.href = destination.href;
    }, 120);
  });

  window.addEventListener('pageshow', () => {
    document.body.classList.remove('cm-page-leaving');
  });
</script>
