<div class="cm-pointer-ring" aria-hidden="true"></div>

<style is:global>
  body {
    animation: cm-page-fade-in .18s ease-out both;
  }

  body.cm-page-leaving {
    animation: none !important;
    opacity: 0;
    transition: opacity .12s ease-in !important;
  }

  @keyframes cm-page-fade-in {
    from { opacity: .18; }
    to { opacity: 1; }
  }

  @media (pointer:fine) {
    a[href], button, [role="button"], .project-card { cursor: pointer !important; }

    .cm-pointer-ring {
      position: fixed;
      left: 0;
      top: 0;
      width: 25px;
      height: 25px;
      border: 1.5px solid rgba(22,111,255,.68);
      border-radius: 999px;
      background: rgba(22,111,255,.025);
      box-shadow: 0 0 0 1px rgba(255,255,255,.36), 0 3px 16px rgba(22,111,255,.08);
      pointer-events: none;
      z-index: 10000;
      opacity: 0;
      transform: translate(-50%,-50%);
      transition: width .15s cubic-bezier(.22,1,.36,1), height .15s cubic-bezier(.22,1,.36,1), opacity .12s ease, background .15s ease, border-color .15s ease, box-shadow .15s ease;
      will-change: left, top, width, height;
    }

    .cm-pointer-ring.is-interactive {
      width: 34px;
      height: 34px;
      opacity: .92;
      border-color: rgba(22,111,255,.82);
      background: rgba(22,111,255,.055);
      box-shadow: 0 0 0 4px rgba(22,111,255,.035), 0 4px 18px rgba(22,111,255,.10);
    }

    .cm-pointer-ring.is-down {
      width: 23px;
      height: 23px;
      background: rgba(22,111,255,.14);
      border-color: rgba(22,111,255,.95);
    }

    .cm-click-ripple {
      position: fixed;
      width: 12px;
      height: 12px;
      border: 1.5px solid rgba(22,111,255,.76);
      border-radius: 50%;
      pointer-events: none;
      z-index: 9999;
      transform: translate(-50%,-50%) scale(.55);
      opacity: .82;
      animation: cm-pointer-ripple .36s cubic-bezier(.16,1,.3,1) forwards;
    }

    @keyframes cm-pointer-ripple {
      to {
        width: 54px;
        height: 54px;
        opacity: 0;
        transform: translate(-50%,-50%) scale(1);
      }
    }
  }

  @media (pointer:coarse) {
    .cm-pointer-ring { display:none !important; }
  }

  /* CINEMATIC PROJECT CAROUSEL */
  .stories-showcase .impact-carousel {
    position: relative !important;
    background: #04142d !important;
    box-shadow: 0 34px 90px rgba(6,23,48,.18) !important;
    overflow: hidden !important;
    isolation: isolate;
  }

  .stories-showcase .impact-stage {
    height: clamp(670px, 52vw, 900px) !important;
    background: #04142d !important;
  }

  .stories-showcase .impact-slide {
    background: #04142d !important;
    opacity: 0 !important;
    visibility: hidden !important;
    clip-path: inset(0 0 0 5%);
    transform: scale(.992);
    transition:
      opacity .72s cubic-bezier(.22,1,.36,1),
      clip-path .88s cubic-bezier(.16,1,.3,1),
      transform .88s cubic-bezier(.16,1,.3,1),
      visibility .72s !important;
  }

  .stories-showcase .impact-slide.is-active {
    opacity: 1 !important;
    visibility: visible !important;
    clip-path: inset(0 0 0 0);
    transform: scale(1);
  }

  .stories-showcase .impact-image {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: top center !important;
    filter: saturate(.9) contrast(1.02) brightness(.9) !important;
    transform: scale(1.075) translateX(1.4%) !important;
    opacity: .65;
    transition:
      transform 1.15s cubic-bezier(.16,1,.3,1),
      filter 1s ease,
      opacity .8s ease !important;
    will-change: transform, opacity;
  }

  .stories-showcase .impact-slide.is-active .impact-image {
    transform: scale(1.005) translateX(0) !important;
    filter: saturate(1) contrast(1.035) brightness(1) !important;
    opacity: 1;
  }

  .stories-showcase .impact-shade {
    position: absolute !important;
    inset: 0 !important;
    z-index: 1 !important;
    overflow: hidden;
    background:
      linear-gradient(90deg,
        rgba(3,15,35,.99) 0%,
        rgba(5,31,71,.985) 18%,
        rgba(9,61,135,.94) 34%,
        rgba(26,111,225,.68) 47%,
        rgba(49,137,255,.30) 57%,
        rgba(41,128,255,.09) 66%,
        rgba(41,128,255,0) 76%) !important;
  }

  .stories-showcase .impact-shade::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 27%, rgba(120,183,255,.17) 44%, transparent 58%);
    transform: translateX(-110%);
    opacity: 0;
  }

  .stories-showcase .impact-slide.is-active .impact-shade::after {
    animation: cm-carousel-light-sweep 1.15s .12s cubic-bezier(.16,1,.3,1) both;
  }

  @keyframes cm-carousel-light-sweep {
    0% { transform: translateX(-110%); opacity: 0; }
    25% { opacity: .65; }
    100% { transform: translateX(105%); opacity: 0; }
  }

  .stories-showcase .impact-topline {
    position: absolute !important;
    top: 22px !important;
    left: clamp(24px,3vw,58px) !important;
    right: clamp(24px,3vw,58px) !important;
    height: auto !important;
    padding: 0 !important;
    display: flex !important;
    align-items: flex-start !important;
    justify-content: space-between !important;
    z-index: 4 !important;
    border: 0 !important;
    background: transparent !important;
    backdrop-filter: none !important;
  }

  .stories-showcase .impact-domain,
  .stories-showcase .impact-project {
    padding: 9px 13px !important;
    border-radius: 999px !important;
    background: rgba(255,255,255,.90) !important;
    border: 1px solid rgba(255,255,255,.65) !important;
    box-shadow: 0 12px 35px rgba(0,12,35,.14) !important;
    backdrop-filter: blur(16px) !important;
    color: #07172f !important;
  }

  .stories-showcase .impact-domain i { background: #a9b9cd !important; }
  .stories-showcase .impact-project {
    color: #07172f !important;
    font-size: .65rem !important;
  }

  .stories-showcase .impact-content-wrap {
    position: relative !important;
    z-index: 3 !important;
    height: 100% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    padding-top: 84px !important;
    padding-bottom: 88px !important;
  }

  .stories-showcase .impact-copy {
    width: min(610px, 43vw) !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    backdrop-filter: none !important;
    color: #fff !important;
    opacity: 0 !important;
    transform: translateX(-46px) !important;
    filter: blur(8px);
    transition:
      opacity .55s .17s ease,
      transform .82s .12s cubic-bezier(.16,1,.3,1),
      filter .7s .12s ease !important;
  }

  .stories-showcase .impact-slide.is-active .impact-copy {
    opacity: 1 !important;
    transform: translateX(0) !important;
    filter: blur(0);
  }

  .stories-showcase .impact-kicker,
  .stories-showcase .impact-copy h3,
  .stories-showcase .impact-copy > p,
  .stories-showcase .impact-detail,
  .stories-showcase .impact-cta {
    opacity: 0;
    transform: translateX(-28px);
  }

  .stories-showcase .impact-slide.is-active .impact-kicker { animation: cm-copy-in .62s .24s cubic-bezier(.16,1,.3,1) forwards; }
  .stories-showcase .impact-slide.is-active .impact-copy h3 { animation: cm-copy-in .72s .32s cubic-bezier(.16,1,.3,1) forwards; }
  .stories-showcase .impact-slide.is-active .impact-copy > p { animation: cm-copy-in .68s .43s cubic-bezier(.16,1,.3,1) forwards; }
  .stories-showcase .impact-slide.is-active .impact-detail { animation: cm-copy-in .68s .52s cubic-bezier(.16,1,.3,1) forwards; }
  .stories-showcase .impact-slide.is-active .impact-cta { animation: cm-copy-in .68s .61s cubic-bezier(.16,1,.3,1) forwards; }

  @keyframes cm-copy-in {
    from { opacity: 0; transform: translateX(-28px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .stories-showcase .impact-kicker {
    display: inline-flex !important;
    align-items: center;
    gap: 9px;
    margin-bottom: 15px !important;
    color: #8bc2ff !important;
    font-size: .7rem !important;
    font-weight: 900 !important;
    letter-spacing: .15em !important;
    text-transform: uppercase !important;
  }

  .stories-showcase .impact-kicker::before {
    content: '';
    width: 28px;
    height: 1px;
    background: linear-gradient(90deg,#6eb0ff,transparent);
  }

  .stories-showcase .impact-copy h3 {
    margin: 0 0 22px !important;
    max-width: 600px;
    font-size: clamp(3.5rem,5.7vw,6.6rem) !important;
    line-height: .86 !important;
    letter-spacing: -.06em !important;
    color: #fff !important;
    text-shadow: 0 15px 45px rgba(0,15,45,.22) !important;
    text-wrap: balance;
  }

  .stories-showcase .impact-copy > p {
    max-width: 520px !important;
    margin: 0 0 24px !important;
    font-size: clamp(1.02rem,1.25vw,1.22rem) !important;
    line-height: 1.55 !important;
    color: rgba(255,255,255,.84) !important;
  }

  .stories-showcase .impact-detail {
    display: grid !important;
    grid-template-columns: 108px minmax(0,1fr) !important;
    gap: 16px !important;
    align-items: start !important;
    max-width: 560px !important;
    margin: 0 0 25px !important;
    padding: 16px 18px !important;
    border: 1px solid rgba(255,255,255,.17) !important;
    border-radius: 16px !important;
    background: rgba(1,16,39,.20) !important;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.05) !important;
    backdrop-filter: blur(6px) !important;
  }

  .stories-showcase .impact-detail strong {
    padding-top: 2px !important;
    color: #8bc2ff !important;
    font-size: .64rem !important;
    font-weight: 900 !important;
    letter-spacing: .12em !important;
    text-transform: uppercase !important;
  }

  .stories-showcase .impact-detail span {
    color: rgba(255,255,255,.92) !important;
    font-size: .86rem !important;
    line-height: 1.5 !important;
    font-weight: 650 !important;
  }

  .stories-showcase .impact-cta {
    display: inline-flex !important;
    align-items: center !important;
    gap: 12px !important;
    padding: 13px 18px !important;
    border-radius: 999px !important;
    background: #fff !important;
    color: #07172f !important;
    font-size: .86rem !important;
    font-weight: 850 !important;
    box-shadow: 0 16px 40px rgba(0,17,54,.22) !important;
    transition: transform .22s ease, box-shadow .22s ease !important;
  }

  .stories-showcase .impact-cta:hover {
    transform: translateY(-3px) !important;
    box-shadow: 0 20px 48px rgba(0,17,54,.30) !important;
  }

  .stories-showcase .impact-cta span { color: #166fff !important; }

  .stories-showcase .impact-index {
    right: clamp(24px,3vw,58px) !important;
    bottom: 30px !important;
    z-index: 4 !important;
    padding: 9px 12px !important;
    border-radius: 999px !important;
    background: rgba(4,20,45,.68) !important;
    border: 1px solid rgba(255,255,255,.14) !important;
    color: #fff !important;
    backdrop-filter: blur(12px) !important;
    font-size: 1rem !important;
  }

  .stories-showcase .impact-controls {
    height: 70px !important;
    position: relative !important;
    z-index: 6 !important;
    background: linear-gradient(90deg,#04142d 0%,#08254f 50%,#04142d 100%) !important;
    border-top: 1px solid rgba(255,255,255,.07);
  }

  .stories-showcase .impact-arrows button {
    border-color: rgba(255,255,255,.20) !important;
    background: rgba(255,255,255,.07) !important;
    backdrop-filter: blur(12px);
  }

  .stories-showcase .impact-progress button.is-active span {
    background: linear-gradient(90deg,#5ea6ff,#1774ff) !important;
    box-shadow: 0 0 18px rgba(45,130,255,.55);
  }

  @media (max-width: 980px) {
    .stories-showcase .impact-stage { height: 760px !important; }
    .stories-showcase .impact-shade {
      background:
        linear-gradient(90deg,
          rgba(3,15,35,.99) 0%,
          rgba(6,37,84,.96) 30%,
          rgba(22,94,197,.68) 55%,
          rgba(35,120,245,.17) 74%,
          transparent 90%) !important;
    }
    .stories-showcase .impact-copy { width: min(570px,58vw) !important; }
    .stories-showcase .impact-copy h3 { font-size: clamp(3.2rem,7vw,5.5rem) !important; }
  }

  @media (max-width: 700px) {
    .stories-showcase .impact-stage { height: 720px !important; }
    .stories-showcase .impact-image { object-position: 58% top !important; }
    .stories-showcase .impact-shade {
      background:
        linear-gradient(90deg,
          rgba(3,15,35,.99) 0%,
          rgba(6,37,84,.94) 45%,
          rgba(22,94,197,.62) 72%,
          rgba(22,94,197,.18) 100%) !important;
    }
    .stories-showcase .impact-topline {
      top: 14px !important;
      left: 14px !important;
      right: 14px !important;
    }
    .stories-showcase .impact-project { display: none !important; }
    .stories-showcase .impact-content-wrap {
      padding: 76px 20px 68px !important;
      align-items: center !important;
    }
    .stories-showcase .impact-copy { width: 100% !important; }
    .stories-showcase .impact-copy h3 {
      max-width: 88%;
      font-size: clamp(3rem,13vw,4.5rem) !important;
    }
    .stories-showcase .impact-copy > p {
      max-width: 92% !important;
      font-size: .96rem !important;
    }
    .stories-showcase .impact-detail {
      max-width: 92% !important;
      grid-template-columns: 1fr !important;
      gap: 6px !important;
      background: rgba(1,16,39,.26) !important;
    }
    .stories-showcase .impact-index {
      right: 14px !important;
      bottom: 18px !important;
    }
  }

  @media (prefers-reduced-motion:reduce) {
    body { animation:none !important; }
    body.cm-page-leaving { opacity:1 !important; transition:none !important; }
    .cm-pointer-ring,.cm-click-ripple { display:none !important; }
    .stories-showcase .impact-slide,
    .stories-showcase .impact-image,
    .stories-showcase .impact-copy,
    .stories-showcase .impact-kicker,
    .stories-showcase .impact-copy h3,
    .stories-showcase .impact-copy > p,
    .stories-showcase .impact-detail,
    .stories-showcase .impact-cta,
    .stories-showcase .impact-shade::after {
      animation: none !important;
      transition: none !important;
      transform: none !important;
      filter: none !important;
    }
  }
</style>

<script>
  const PROJECT_IMAGES = {
    fastTrack: '/assets/fasttrack-story.png?v=9',
    miArmario: '/assets/miarmario-story.png?v=9'
  };

  const repairProjectImages = () => {
    document.querySelectorAll('img').forEach((img) => {
      if (!(img instanceof HTMLImageElement)) return;
      const alt = (img.alt || '').toLowerCase();
      const current = img.getAttribute('src') || '';
      const isFastTrack = alt.includes('fast track english coach') || current.includes('fasttrack-story');
      const isMiArmario = alt.includes('mi armario cancún') || alt.includes('mi armario cancun') || current.includes('miarmario-story');

      if (isFastTrack) {
        if (img.getAttribute('src') !== PROJECT_IMAGES.fastTrack) img.setAttribute('src', PROJECT_IMAGES.fastTrack);
        img.removeAttribute('srcset');
        img.decoding = 'async';
      } else if (isMiArmario) {
        if (img.getAttribute('src') !== PROJECT_IMAGES.miArmario) img.setAttribute('src', PROJECT_IMAGES.miArmario);
        img.removeAttribute('srcset');
        img.decoding = 'async';
      }
    });
  };

  repairProjectImages();
  document.addEventListener('DOMContentLoaded', repairProjectImages, { once:true });
  window.addEventListener('pageshow', repairProjectImages);

  const finePointer = window.matchMedia('(pointer:fine)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion:reduce)');
  const ring = document.querySelector('.cm-pointer-ring');

  if (finePointer.matches && ring instanceof HTMLElement) {
    let targetX = -100;
    let targetY = -100;
    let currentX = -100;
    let currentY = -100;
    let visible = false;
    const interactiveSelector = 'a[href],button,[role="button"],.project-card';

    const animateRing = () => {
      currentX += (targetX - currentX) * .34;
      currentY += (targetY - currentY) * .34;
      ring.style.left = `${currentX}px`;
      ring.style.top = `${currentY}px`;
      requestAnimationFrame(animateRing);
    };
    requestAnimationFrame(animateRing);

    document.addEventListener('pointermove', (event) => {
      targetX = event.clientX;
      targetY = event.clientY;
      if (!visible) {
        currentX = targetX;
        currentY = targetY;
        visible = true;
      }
      const target = event.target instanceof Element ? event.target.closest(interactiveSelector) : null;
      ring.classList.toggle('is-interactive', Boolean(target));
    }, { passive:true });

    document.addEventListener('pointerdown', (event) => {
      const target = event.target instanceof Element ? event.target.closest(interactiveSelector) : null;
      if (!target) return;
      ring.classList.add('is-down');
      const ripple = document.createElement('span');
      ripple.className = 'cm-click-ripple';
      ripple.style.left = `${event.clientX}px`;
      ripple.style.top = `${event.clientY}px`;
      document.body.appendChild(ripple);
      window.setTimeout(() => ripple.remove(), 420);
    }, { passive:true });

    const release = () => ring.classList.remove('is-down');
    document.addEventListener('pointerup', release, { passive:true });
    document.addEventListener('pointercancel', release, { passive:true });
    document.documentElement.addEventListener('mouseleave', () => ring.classList.remove('is-interactive'));
  }

  document.addEventListener('click', (event) => {
    if (event.defaultPrevented || reducedMotion.matches) return;
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

    const target = event.target instanceof Element ? event.target.closest('a[href]') : null;
    if (!(target instanceof HTMLAnchorElement)) return;
    if (target.target === '_blank' || target.hasAttribute('download')) return;

    const rawHref = target.getAttribute('href');
    if (!rawHref || rawHref.startsWith('#') || rawHref.startsWith('mailto:') || rawHref.startsWith('tel:')) return;

    const destination = new URL(target.href, window.location.href);
    if (destination.origin !== window.location.origin) return;
    if (destination.pathname === window.location.pathname && destination.search === window.location.search) return;

    event.preventDefault();
    document.body.classList.add('cm-page-leaving');
    window.setTimeout(() => { window.location.href = destination.href; }, 120);
  });

  window.addEventListener('pageshow', () => {
    document.body.classList.remove('cm-page-leaving');
  });
</script>