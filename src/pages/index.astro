---
import Layout from '../layouts/Layout.astro';
import Interactions from '../components/Interactions.astro';
---
<Layout>
  <Interactions />
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Identidad digital con dirección</span>
        <h1>Tu negocio merece verse <strong class="accent">tan profesional</strong> como realmente es.</h1>
        <p class="lead">Diseñamos sitios web rápidos, elegantes y estratégicos que convierten una primera visita en confianza. Tu página deja de ser un requisito y se convierte en parte de tu crecimiento.</p>
        <div class="hero-actions">
          <a class="button button-blue" href="/contacto">Quiero cotizar mi sitio <span>→</span></a>
          <a class="button button-ghost" href="/proyectos">Ver proyectos</a>
        </div>
        <div class="trust-row"><span>Diseño responsive</span><span>Enfoque en conversión</span><span>Entrega profesional</span></div>
      </div>
      <div class="hero-visual" aria-label="Vista conceptual de un sitio web moderno">
        <div class="orb"><div class="orbit"></div></div>
        <div class="browser-card">
          <div class="browser-bar"><i></i><i></i><i></i></div>
          <div class="browser-body">
            <div class="browser-title"></div><div class="browser-line blue"></div><div class="browser-line"></div><div class="browser-line" style="width:68%"></div>
            <div class="browser-grid"><span></span><span></span></div>
          </div>
        </div>
        <div class="price-float"><small>Landing Esencial</small><b>desde $2,000</b><em> MXN · 3 secciones</em></div>
      </div>
    </div>
  </section>

  <section class="section dark-band">
    <div class="container" data-reveal>
      <span class="eyebrow">Más que páginas bonitas</span>
      <div class="section-head"><h2>Diseño que construye reputación antes de la primera llamada.</h2><p class="lead">Orden visual, velocidad, claridad y una experiencia pensada para que tu cliente entienda qué haces, por qué confiar en ti y cómo contactarte.</p></div>
      <div class="metrics"><div class="metric"><b>2025</b><span>El inicio de nuestro recorrido</span></div><div class="metric"><b>100%</b><span>Enfoque responsive</span></div><div class="metric"><b>3</b><span>Secciones desde el plan inicial</span></div><div class="metric"><b>1:1</b><span>Atención durante tu proyecto</span></div></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal><div><span class="eyebrow">Servicios</span><h2>Lo necesario para construir una presencia que inspire confianza.</h2></div><a class="button button-ghost" href="/servicios">Explorar servicios</a></div>
      <div class="service-grid">
        <article class="service-card price-card" data-reveal><span class="service-number">PLAN DE ENTRADA</span><h3>Landing Esencial</h3><div class="price-big">$2,000 <small>MXN desde</small></div><p>Tres secciones estratégicas: impacto inicial, propuesta/servicios y conversión. Ideal para comenzar con una presencia profesional sin complicar el proyecto.</p><a class="button button-blue" href="/contacto" style="margin-top:24px">Solicitar cotización →</a></article>
        <article class="service-card" data-reveal><span class="service-number">01</span><h3>Sitios corporativos</h3><p>Arquitectura multipágina, contenido organizado y una experiencia coherente para presentar una empresa con mayor profundidad.</p></article>
        <article class="service-card" data-reveal><span class="service-number">02</span><h3>Diseño UX/UI</h3><p>Jerarquía visual, navegación intuitiva y microinteracciones elegantes que hacen que la experiencia se sienta cuidada.</p></article>
        <article class="service-card" data-reveal><span class="service-number">03</span><h3>Optimización web</h3><p>Buenas prácticas de rendimiento, SEO técnico básico, accesibilidad y adaptación para teléfonos, tablets y escritorio.</p></article>
        <article class="service-card" data-reveal><span class="service-number">04</span><h3>Identidad digital</h3><p>Traducimos la personalidad de tu negocio a tipografía, color, tono visual y componentes que funcionan en la web.</p></article>
      </div>
    </div>
  </section>

  <section class="section stories-showcase" id="historias">
    <div class="container">
      <div class="stories-head" data-reveal>
        <div>
          <span class="eyebrow">Historias que acompañamos</span>
          <h2>Cuando una página deja de ser escaparate y empieza a resolver necesidades reales.</h2>
          <p class="lead">Dos marcas cancunenses lideradas por mujeres emprendedoras. Dos maneras distintas de usar la tecnología para acercarse mejor a sus clientes.</p>
        </div>
        <a class="button button-ghost" href="/proyectos">Conocer las historias</a>
      </div>

      <div class="story-carousel" data-story-carousel data-reveal aria-roledescription="carrusel" aria-label="Historias de clientes de Conexión Metrópoli">
        <div class="story-carousel-stage" aria-live="polite">
          <article class="story-slide is-active" data-story-slide aria-hidden="false">
            <div class="story-slide-visual">
              <div class="real-browser">
                <div class="real-browser-bar"><div class="browser-dots"><i></i><i></i><i></i></div><span>fasttrackenglishcoach.com</span><b>Proyecto real · Cancún</b></div>
                <div class="real-browser-screen">
                  <img class="story-shot" data-b64-src="/assets/fasttrack-story.jpg.b64?v=3" data-mime="image/jpeg" alt="Página de inicio de Fast Track English Coach" />
                  <div class="shot-loader" aria-hidden="true"><span></span></div>
                </div>
              </div>
            </div>
            <div class="story-slide-copy">
              <div class="slide-index"><span>01</span><small>/ 02</small></div>
              <span class="story-kicker">Educación · Experiencia + evaluación</span>
              <h3>Fast Track English Coach</h3>
              <p class="story-quote">Una página que ayuda al alumno a dar el primer paso antes de llegar a clase.</p>
              <p>Propusimos integrar una evaluación de inglés en línea para que cada futuro alumno pueda conocer una referencia de su nivel y llegar con mayor confianza a recibir orientación sobre el curso más adecuado.</p>
              <div class="story-outcome"><span>La idea clave</span><strong>Convertir el sitio en parte del proceso de orientación, no solo en publicidad.</strong></div>
              <a class="story-cta" href="/proyectos#fast-track">Conocer la historia completa <span>↗</span></a>
            </div>
          </article>

          <article class="story-slide" data-story-slide aria-hidden="true">
            <div class="story-slide-visual">
              <div class="real-browser">
                <div class="real-browser-bar"><div class="browser-dots"><i></i><i></i><i></i></div><span>miarmariocancun.com</span><b>Proyecto real · Cancún</b></div>
                <div class="real-browser-screen">
                  <img class="story-shot" data-b64-src="/assets/miarmario-story.webp.b64?v=3" data-mime="image/webp" alt="Página de inicio de la tienda en línea Mi Armario Cancún" />
                  <div class="shot-loader" aria-hidden="true"><span></span></div>
                </div>
              </div>
            </div>
            <div class="story-slide-copy">
              <div class="slide-index"><span>02</span><small>/ 02</small></div>
              <span class="story-kicker">Moda · E-commerce</span>
              <h3>Mi Armario Cancún</h3>
              <p class="story-quote">Una tienda digital para que una colección completa pueda descubrirse más allá de una publicación.</p>
              <p>Construimos una tienda en línea para convertir la variedad de trajes de baño, vestidos y accesorios de la marca en un catálogo visual que sus clientas pueden explorar desde cualquier lugar y dispositivo.</p>
              <div class="story-outcome"><span>La idea clave</span><strong>Extender el escaparate de la marca a una experiencia de compra disponible en cualquier momento.</strong></div>
              <a class="story-cta" href="/proyectos#mi-armario">Conocer la historia completa <span>↗</span></a>
            </div>
          </article>
        </div>

        <div class="carousel-controls" aria-label="Controles del carrusel">
          <div class="carousel-nav">
            <button class="carousel-arrow" type="button" data-carousel-prev aria-label="Historia anterior">←</button>
            <button class="carousel-arrow" type="button" data-carousel-next aria-label="Historia siguiente">→</button>
          </div>
          <div class="carousel-progress" aria-label="Seleccionar historia">
            <button class="carousel-dot is-active" type="button" data-carousel-dot="0" aria-label="Ver Fast Track English Coach" aria-current="true"><span></span></button>
            <button class="carousel-dot" type="button" data-carousel-dot="1" aria-label="Ver Mi Armario Cancún"><span></span></button>
          </div>
          <span class="carousel-hint">También puedes deslizar</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" data-reveal><div class="cta-panel"><span class="eyebrow">Tu siguiente paso</span><h2>Haz que tu negocio se vea como la opción que tus clientes estaban buscando.</h2><p class="lead">Cuéntanos qué quieres construir. Te responderemos con una propuesta clara según el alcance de tu proyecto.</p><a class="button button-blue" href="/contacto" style="margin-top:20px">Empezar mi proyecto →</a></div></div>
  </section>
</Layout>

<style>
  .stories-showcase{background:linear-gradient(180deg,#edf2f8 0%,#f4f7fb 100%);overflow:hidden}
  .stories-head{display:grid;grid-template-columns:1fr auto;gap:45px;align-items:end;margin-bottom:46px}
  .stories-head h2{max-width:880px;margin:8px 0 22px}
  .stories-head .lead{max-width:760px;margin:0}
  .story-carousel{position:relative}
  .story-carousel-stage{position:relative;min-height:610px}
  .story-slide{position:absolute;inset:0;display:grid;grid-template-columns:minmax(0,1.16fr) minmax(330px,.84fr);background:rgba(255,255,255,.96);border:1px solid rgba(203,215,231,.9);border-radius:34px;overflow:hidden;box-shadow:0 34px 90px rgba(7,23,47,.11);opacity:0;visibility:hidden;pointer-events:none;transform:translateX(26px) scale(.988);transition:opacity .58s cubic-bezier(.22,1,.36,1),transform .68s cubic-bezier(.22,1,.36,1),visibility .58s}
  .story-slide.is-active{opacity:1;visibility:visible;pointer-events:auto;transform:translateX(0) scale(1);z-index:2}
  .story-slide-visual{padding:30px;background:radial-gradient(circle at 22% 15%,rgba(22,111,255,.18),transparent 34%),linear-gradient(145deg,#d9e6f6,#edf3fa);display:flex;align-items:center}
  .real-browser{width:100%;border:1px solid rgba(255,255,255,.9);border-radius:22px;overflow:hidden;background:#fff;box-shadow:0 26px 55px rgba(7,23,47,.17);transform:perspective(1300px) rotateY(1.4deg) rotateX(.5deg);transition:transform .7s cubic-bezier(.22,1,.36,1)}
  .story-slide.is-active .real-browser{transform:perspective(1300px) rotateY(0) rotateX(0)}
  .real-browser-bar{height:43px;padding:0 14px;display:grid;grid-template-columns:auto 1fr auto;gap:13px;align-items:center;border-bottom:1px solid #e6ebf2;color:#708098;font-size:.72rem;background:#fbfcfe}
  .real-browser-bar>b{font-size:.65rem;text-transform:uppercase;letter-spacing:.09em;color:#236ce2}
  .browser-dots{display:flex;gap:5px}.browser-dots i{width:7px;height:7px;border-radius:50%;background:#b8c5d6}
  .real-browser-screen{position:relative;aspect-ratio:1.78/1;background:linear-gradient(115deg,#e5edf7,#f7f9fc);overflow:hidden}
  .story-shot{position:relative;z-index:2;width:100%;height:100%;display:block;object-fit:cover;object-position:top center;opacity:0;transform:scale(1.025);transition:opacity .45s ease,transform 1.1s cubic-bezier(.22,1,.36,1)}
  .story-shot.is-loaded{opacity:1;transform:scale(1)}
  .shot-loader{position:absolute;inset:0;display:grid;place-items:center;z-index:1}.shot-loader span{width:30px;height:30px;border:2px solid #c9d7e9;border-top-color:#166fff;border-radius:50%;animation:shot-spin .8s linear infinite}
  .story-shot.is-loaded+.shot-loader{opacity:0;transition:opacity .25s;pointer-events:none}
  @keyframes shot-spin{to{transform:rotate(360deg)}}
  .story-slide-copy{padding:clamp(35px,4vw,58px);display:flex;flex-direction:column;justify-content:center;position:relative}
  .slide-index{position:absolute;top:28px;right:34px;display:flex;align-items:baseline;gap:5px;color:#9aa9bc}.slide-index span{font-size:1.25rem;font-weight:850;color:#0d213c}.slide-index small{font-size:.72rem}
  .story-kicker{color:#166fff;font-size:.72rem;font-weight:850;letter-spacing:.13em;text-transform:uppercase}
  .story-slide-copy h3{font-size:clamp(2.4rem,4.1vw,4rem);letter-spacing:-.05em;margin:10px 0 18px;line-height:.95}
  .story-quote{font-size:clamp(1.12rem,1.5vw,1.35rem);font-weight:700;color:#263d5d;line-height:1.42;margin-bottom:18px}
  .story-slide-copy>p:not(.story-quote){color:var(--muted);font-size:.98rem}
  .story-outcome{margin:14px 0 26px;padding:18px 19px;border-left:3px solid var(--blue);background:#f2f6fb;border-radius:0 14px 14px 0}.story-outcome span{display:block;font-size:.67rem;font-weight:850;color:var(--blue);text-transform:uppercase;letter-spacing:.11em;margin-bottom:5px}.story-outcome strong{font-size:.9rem;line-height:1.45;color:#183250}
  .story-cta{display:inline-flex;align-items:center;gap:10px;align-self:flex-start;font-weight:800;color:#0a54ce}.story-cta span{transition:transform .2s}.story-cta:hover span{transform:translate(3px,-2px)}
  .carousel-controls{display:flex;align-items:center;gap:18px;margin-top:25px;padding:0 5px}
  .carousel-nav{display:flex;gap:8px}.carousel-arrow{width:48px;height:48px;border-radius:50%;border:1px solid #cdd8e7;background:rgba(255,255,255,.8);color:#10213a;font-size:1.2rem;cursor:pointer;transition:transform .2s,border-color .2s,background .2s,box-shadow .2s}.carousel-arrow:hover{background:#fff;border-color:#99b7df;transform:translateY(-2px);box-shadow:0 9px 22px rgba(7,23,47,.09)}
  .carousel-progress{display:flex;gap:7px;align-items:center}.carousel-dot{border:0;background:transparent;padding:8px 2px;cursor:pointer}.carousel-dot span{display:block;width:28px;height:3px;border-radius:4px;background:#bdcadb;transition:width .35s,background .35s}.carousel-dot.is-active span{width:58px;background:#166fff}.carousel-hint{margin-left:auto;color:#8090a6;font-size:.76rem}
  @media(max-width:960px){.stories-head{grid-template-columns:1fr}.stories-head .button{justify-self:start}.story-carousel-stage{min-height:780px}.story-slide{grid-template-columns:1fr;grid-template-rows:auto 1fr}.story-slide-visual{padding:22px}.story-slide-copy{padding:34px 30px 40px}.real-browser-screen{aspect-ratio:1.8/1}}
  @media(max-width:620px){.story-carousel-stage{min-height:750px}.story-slide{border-radius:24px}.story-slide-visual{padding:13px}.real-browser{border-radius:15px}.real-browser-bar{height:35px;grid-template-columns:auto 1fr;padding:0 10px}.real-browser-bar>b{display:none}.story-slide-copy{padding:28px 22px 34px}.slide-index{top:19px;right:20px}.story-slide-copy h3{font-size:2.35rem;padding-right:45px}.story-quote{font-size:1.03rem}.carousel-hint{display:none}.carousel-controls{justify-content:space-between}.carousel-dot.is-active span{width:42px}}
  @media(prefers-reduced-motion:reduce){.story-slide,.real-browser,.story-shot,.carousel-dot span{transition:none!important}.shot-loader span{animation:none}}
</style>

<script>
  const hydrateStoryImages = async () => {
    const images = [...document.querySelectorAll('[data-b64-src]')];
    await Promise.all(images.map(async (image) => {
      if (!(image instanceof HTMLImageElement) || image.dataset.hydrated === 'true') return;
      try {
        const response = await fetch(image.dataset.b64Src || '', { cache: 'force-cache' });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const base64 = (await response.text()).trim();
        if (!base64) throw new Error('Imagen vacía');
        image.src = `data:${image.dataset.mime || 'image/webp'};base64,${base64}`;
        image.dataset.hydrated = 'true';
        if (image.complete) image.classList.add('is-loaded');
        else image.addEventListener('load', () => image.classList.add('is-loaded'), { once: true });
      } catch (error) {
        console.error('No se pudo cargar la captura del proyecto', error);
      }
    }));
  };

  hydrateStoryImages();

  const carousel = document.querySelector('[data-story-carousel]');
  if (carousel instanceof HTMLElement) {
    const slides = [...carousel.querySelectorAll('[data-story-slide]')];
    const dots = [...carousel.querySelectorAll('[data-carousel-dot]')];
    const prev = carousel.querySelector('[data-carousel-prev]');
    const next = carousel.querySelector('[data-carousel-next]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer;
    let startX = 0;
    let paused = false;

    const show = (index) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === current;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
      dots.forEach((dot, i) => {
        const active = i === current;
        dot.classList.toggle('is-active', active);
        if (active) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };

    const stop = () => { if (timer) window.clearInterval(timer); };
    const start = () => {
      stop();
      if (!reducedMotion && !paused) timer = window.setInterval(() => show(current + 1), 5800);
    };
    const move = (delta) => { show(current + delta); start(); };

    prev?.addEventListener('click', () => move(-1));
    next?.addEventListener('click', () => move(1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => { show(i); start(); }));
    carousel.addEventListener('mouseenter', () => { paused = true; stop(); });
    carousel.addEventListener('mouseleave', () => { paused = false; start(); });
    carousel.addEventListener('focusin', () => { paused = true; stop(); });
    carousel.addEventListener('focusout', () => { paused = false; start(); });
    carousel.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') move(-1);
      if (event.key === 'ArrowRight') move(1);
    });
    carousel.addEventListener('pointerdown', (event) => { startX = event.clientX; });
    carousel.addEventListener('pointerup', (event) => {
      const distance = event.clientX - startX;
      if (Math.abs(distance) > 55) move(distance > 0 ? -1 : 1);
    });
    document.addEventListener('visibilitychange', () => document.hidden ? stop() : start());
    start();
  }
</script>
